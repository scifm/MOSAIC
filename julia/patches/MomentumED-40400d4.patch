diff --git a/MomentumED/src/method/gpu_linear_map.jl b/MomentumED/src/method/gpu_linear_map.jl
index f423c74..a97fde3 100644
--- a/MomentumED/src/method/gpu_linear_map.jl
+++ b/MomentumED/src/method/gpu_linear_map.jl
@@ -6,6 +6,15 @@ Only names and method signatures are defined here; the actual code is in the ext
 global const CUDA_AVAILABLE = Ref(false)
 global const CUDA_KRYLOV_INPLACE_RESTART_CHUNKSIZE = Ref{Int64}(262144)
 global const CUDA_MEMORY_MONITOR = Ref(true)
+# Full GC + pool reclaim after every Lanczos restart (see the shrink! override in
+# the CUDA extension). Safe for one large solve per process; callers that run
+# several concurrent device solves turn it off, since GC.gc() stops every task.
+global const CUDA_KRYLOV_SHRINK_RELEASE = Ref(true)
+# Cheap alternative for concurrent solves: a minor (young-generation) GC at each
+# restart, which frees the Krylov vectors the restart just discarded. Without
+# either, device memory fills with dead vectors until allocation fails
+# (measured: a 1M-state sector with a 6 GB matrix peaked at 13.8 GB).
+global const CUDA_KRYLOV_SHRINK_MINOR_GC = Ref(false)
 
